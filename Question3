"""
Weekly Temperature Analysis Program

This program allows a user to:
- Enter temperatures for 7 days
- Calculate the lowest, highest, total, and average temperature
- Display the results in a clear format
"""

def main():
    temperatures = []

    # Input temperatures for 7 days
    for i in range(7):
        temp = float(input(f"Enter temperature for day {i + 1}: "))
        temperatures.append(temp)

    # Calculations
    lowest = min(temperatures)
    highest = max(temperatures)
    total = sum(temperatures)
    average = total / len(temperatures)

    # Output results
    print("\n--- Weekly Temperature Report ---")
    print(f"Temperatures: {temperatures}")
    print(f"Lowest Temperature: {lowest}")
    print(f"Highest Temperature: {highest}")
    print(f"Total Temperature: {total}")
    print(f"Average Temperature: {average:.2f}")


if __name__ == "__main__":
    main()
